{
  "name": "retemper",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Project-agnostic plan → accept → build → harden → review → QA → PR cycle for Grok Build, Codex, GitHub Copilot, and Cursor.",
  "author": "Krzysztof Kabala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkabala/retemper.git"
  },
  "bugs": {
    "url": "https://github.com/kkabala/retemper/issues"
  },
  "homepage": "https://github.com/kkabala/retemper#readme",
  "keywords": [
    "retemper",
    "grok",
    "codex",
    "copilot",
    "cursor",
    "agent-skills",
    "cli"
  ],
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "retemper": "./bin/retemper.js",
    "retemper-install": "./bin/retemper-install.js",
    "retemper-uninstall": "./bin/retemper-uninstall.js"
  },
  "files": [
    "bin/",
    "retemper.ts",
    "install.ts",
    "uninstall.ts",
    "lib/",
    "references/",
    "templates/",
    "vendor/",
    ".agents/",
    ".grok/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "install:user": "node install.ts --platform grok --scope user",
    "install:user:dry": "node install.ts --dry-run --platform grok --scope user",
    "install:user:codex": "node install.ts --platform codex --scope user",
    "install:user:codex:dry": "node install.ts --dry-run --platform codex --scope user",
    "install:user:copilot": "node install.ts --platform copilot --scope user",
    "install:user:copilot:dry": "node install.ts --dry-run --platform copilot --scope user",
    "install:user:cursor": "node install.ts --platform cursor --scope user",
    "install:user:cursor:dry": "node install.ts --dry-run --platform cursor --scope user",
    "uninstall:all": "node uninstall.ts --all",
    "uninstall:all:dry": "node uninstall.ts --all --dry-run",
    "update": "node install.ts --update",
    "update:dry": "node install.ts --update --dry-run"
  }
}
